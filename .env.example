# Copy this file to .env for local development.
# Get a Gemini API key from Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here

# Current model IDs can be changed without editing Python code.
WORKOUT_MODEL=gemini-3.1-pro-preview
TIP_MODEL=gemini-3.8-flash

# Change this before any public deployment.
ADMIN_PASSWORD=change-this-password

# Leave DATABASE_URL unset for the included SQLite database.
# DATABASE_URL=sqlite:///./fitbuddy.db
